{
  "default": {
    "paths": ["features/**/*.feature"],
    "import": [
      "features/support/**/*.ts",
      "features/step_definitions/**/*.ts"
    ],
    "format": [
      "@serenity-js/cucumber"
    ],
    "strict": true
  },
  "api": {
    "paths": ["features/**/*.feature"],
    "import": [
      "features/support/**/*.ts",
      "features/step_definitions/**/*.ts"
    ],
    "format": [
      "@serenity-js/cucumber"
    ],
    "strict": true
  },
  "smoke": {
    "paths": ["features/**/*.feature"],
    "tags": "@smoke and not @mutating",
    "import": [
      "features/support/**/*.ts",
      "features/step_definitions/**/*.ts"
    ],
    "format": [
      "@serenity-js/cucumber"
    ],
    "strict": true
  }
}
